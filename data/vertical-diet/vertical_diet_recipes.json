      "steps": [
        {"instruction": "Place diced potatoes in salted water. Bring to boil and cook 10-12 minutes until fork tender. Drain and set aside."},
        {"instruction": "Combine broth and rice in saucepan. Bring to boil, reduce heat, cover and simmer 20 minutes."},
        {"instruction": "Brown ground beef in large skillet with butter. Season with salt."},
        {"instruction": "Add bell peppers when beef is nearly cooked. Sauté 3 minutes."},
        {"instruction": "Add spinach and stir until wilted."},
        {"instruction": "Combine rice, potatoes, and beef mixture. Mix well and serve."}
