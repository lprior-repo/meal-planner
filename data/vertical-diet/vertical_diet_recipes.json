  "recipes": [
    {
      "name": "Monster Mash (Classic)",
      "description": "Stan Efferding's signature Vertical Diet meal - ground beef, white rice, spinach, and peppers cooked in bone broth. The cornerstone of the Vertical Diet.",
      "source_url": "https://mealsbymeg.blog/2022/10/16/monster-mash/",
      "reference_urls": [
        "https://outdoormusclefit.com/vertical-diet-monster-mash-recipe/",
        "https://verticaldiet.com/product/monster-mash-deluxe/"
      ],
      "servings": 4,
      "working_time": 15,
      "waiting_time": 25,
      "keywords": ["vertical-diet", "meal-prep", "high-protein", "muscle-building", "monster-mash"],
      "ingredients": [
        {"amount": 1, "unit": "lb", "food": "lean ground beef (93/7)", "notes": "grass-fed preferred"},
        {"amount": 1, "unit": "cup", "food": "white rice", "notes": "medium or long grain"},
        {"amount": 1.5, "unit": "cups", "food": "chicken bone broth"},
        {"amount": 2, "unit": "cups", "food": "fresh spinach", "notes": "or 1 block frozen"},
        {"amount": 2, "unit": "medium", "food": "bell peppers", "notes": "red, yellow, or orange - diced"},
        {"amount": 1, "unit": "tbsp", "food": "butter", "notes": "or ghee"},
        {"amount": 0.5, "unit": "tsp", "food": "salt"},
        {"amount": 0.25, "unit": "tsp", "food": "black pepper"}
      ],
      "steps": [
        {"instruction": "Combine chicken broth and rice in a medium saucepan. Bring to a boil over high heat."},
        {"instruction": "Reduce heat to low, cover, and simmer for 18-20 minutes until rice is tender and liquid is absorbed."},
        {"instruction": "In a large skillet, melt butter over medium-high heat. Add ground beef and season with salt and pepper."},
        {"instruction": "Brown the beef, breaking it into small pieces, for about 5-7 minutes."},
        {"instruction": "When beef is almost done, add diced bell peppers and cook for 2-3 minutes until slightly softened."},
        {"instruction": "Add spinach and stir until wilted, about 1-2 minutes."},
        {"instruction": "Combine cooked rice with the beef and vegetable mixture. Mix thoroughly."},
        {"instruction": "Divide into meal prep containers. Stores in fridge 4 days or freezer 3 months."}
      ],
      "nutrition": {
        "calories": 438,
        "protein": 32,
        "carbohydrates": 44,
        "fat": 15,
        "saturated_fat": 8,
        "fiber": 2,
        "sodium": 380
      }
    },
