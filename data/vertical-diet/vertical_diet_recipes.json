    {
      "name": "Monster Mash (Classic)",
      "description": "Stan Efferding's signature Vertical Diet meal - ground beef, white rice, spinach, and peppers cooked in bone broth. The cornerstone of the Vertical Diet.",
      "source_url": "https://mealsbymeg.blog/2022/10/16/monster-mash/",
      "reference_urls": [
        "https://outdoormusclefit.com/vertical-diet-monster-mash-recipe/",
        "https://verticaldiet.com/product/monster-mash-deluxe/"
      ],
      "servings": 4,
      "servings_text": "4 servings",
      "working_time": 15,
      "waiting_time": 25,
      "keywords": [{"name": "vertical-diet"}, {"name": "meal-prep"}, {"name": "high-protein"}, {"name": "muscle-building"}, {"name": "monster-mash"}],
      "steps": [
        {
          "name": "Prepare rice",
          "instruction": "Combine chicken broth and rice in a medium saucepan. Bring to a boil over high heat. Reduce heat to low, cover, and simmer for 18-20 minutes until rice is tender and liquid is absorbed.",
          "ingredients": [
            {"amount": 185.0, "unit": {"name": "g"}, "food": {"name": "white rice, uncooked"}, "note": "1 cup, medium or long grain"},
            {"amount": 360.0, "unit": {"name": "ml"}, "food": {"name": "chicken bone broth"}, "note": "1.5 cups"}
          ]
        },
        {
          "name": "Cook beef and vegetables",
          "instruction": "In a large skillet, melt butter over medium-high heat. Add ground beef and season with salt and pepper. Brown the beef, breaking it into small pieces, for about 5-7 minutes. When beef is almost done, add diced bell peppers and cook for 2-3 minutes until slightly softened. Add spinach and stir until wilted, about 1-2 minutes.",
          "ingredients": [
            {"amount": 454.0, "unit": {"name": "g"}, "food": {"name": "ground beef, 93% lean"}, "note": "1 lb, grass-fed preferred"},
            {"amount": 14.0, "unit": {"name": "g"}, "food": {"name": "butter, unsalted"}, "note": "1 tbsp"},
            {"amount": 200.0, "unit": {"name": "g"}, "food": {"name": "bell pepper, mixed colors"}, "note": "2 medium, diced"},
            {"amount": 60.0, "unit": {"name": "g"}, "food": {"name": "spinach, fresh"}, "note": "2 cups"},
            {"amount": 3.0, "unit": {"name": "g"}, "food": {"name": "salt"}, "note": "0.5 tsp"},
            {"amount": 0.5, "unit": {"name": "g"}, "food": {"name": "black pepper, ground"}, "note": "0.25 tsp"}
          ]
        },
        {
          "name": "Combine and serve",
          "instruction": "Combine cooked rice with the beef and vegetable mixture. Mix thoroughly. Divide into meal prep containers. Stores in fridge 4 days or freezer 3 months.",
          "ingredients": []
        }
      ],
