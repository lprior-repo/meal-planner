    {
      "id": "BEAD-004",
      "sequence": 4,
      "name": "Add: Numeric Bounds Validation",
      "priority": "P2-MEDIUM",
      "effort_hours": 2,
      "category": "FEATURE",
      "status": "COMPLETED",
      "binary": "sync_meal_plan",
      "contract": {
        "precondition": "MealPlanEntry with numeric fields",
        "postcondition": "Values validated for reasonable bounds before processing"
      },
      "schema": {
        "fields": {
          "calories": {
            "type": "number",
            "min": 0,
            "max": 100000,
            "error_below_min": "must be >= 0",
            "error_above_max": "must be <= 100000"
          },
          "protein": {
            "type": "number",
            "min": 0,
            "max": 10000
          },
          "carbohydrate": {
            "type": "number",
            "min": 0,
            "max": 10000
          },
          "fat": {
            "type": "number",
            "min": 0,
            "max": 10000
          },
          "servings": {
            "type": "number",
            "min_exclusive": 0,
            "max": 1000,
            "error": "must be > 0"
          },
          "bmr": {
            "type": "number",
            "min": 500,
            "max": 5000
          }
        }
      },
      "test_cases": [
        {
          "name": "Negative calories",
          "input": "calories: -100",
          "expected": "error: Invalid calories -100: must be >= 0"
        },
        {
          "name": "Zero servings",
          "input": "servings: 0",
          "expected": "error: Invalid servings 0: must be > 0"
        },
        {
          "name": "Valid max value",
          "input": "calories: 100000",
          "expected": "Accepted"
        }
      ],
      "acceptance_criteria": [
        "Negative values rejected",
        "Out-of-range values rejected",
        "Clear error messages",
        "Errors in errors array",
        "Entry skipped (not synced)",
        "success = false if validation errors"
      ],
      "depends_on": ["BEAD-001"]
    },
    {
      "id": "BEAD-005",
      "sequence": 5,
      "name": "Add: Date Format Strict Validation",
      "priority": "P2-MEDIUM",
      "effort_hours": 1.5,
      "category": "FEATURE",
      "status": "COMPLETED",
      "binaries": ["sync_meal_plan", "analyze_nutrition", "track_exercise_balance"],
      "contract": {
        "precondition": "Date field in YYYY-MM-DD format",
        "postcondition": "Date must match exact format, invalid dates rejected"
      },
      "schema": {
        "format": "YYYY-MM-DD",
        "constraints": [
          "Exactly 10 characters",
          "Year: 1900-2099",
          "Month: 01-12",
          "Day: 01-31 (valid for month)",
          "Case-sensitive"
        ],
        "edge_cases": [
          "2025-02-29 (invalid non-leap)",
          "2024-02-29 (valid leap)",
          "2025-13-01 (invalid month)",
          "2025-1-1 (invalid padding)"
        ]
      },
      "test_cases": [
        {
          "name": "Valid date",
          "input": "2025-01-15",
          "expected": "Accepted"
        },
        {
          "name": "Invalid format",
          "input": "2025-1-9",
          "expected": "Rejected: must be YYYY-MM-DD"
        },
        {
          "name": "Invalid month",
          "input": "2025-13-01",
          "expected": "Rejected: month 01-12"
        }
      ],
      "acceptance_criteria": [
        "Strict format validation YYYY-MM-DD",
        "Month must be 01-12",
        "Day valid for month (leap year logic)",
        "Year 1900-2099",
        "Error message includes expected format"
      ],
      "depends_on": ["BEAD-001"]
    },
