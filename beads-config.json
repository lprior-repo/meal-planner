    {
      "id": "BEAD-001",
      "sequence": 1,
      "name": "Fix: meal_type Silent Default Validation",
      "priority": "P0-CRITICAL",
      "effort_hours": 1,
      "category": "BUG_FIX",
      "status": "COMPLETED",
      "file": "src/bin/sync_meal_plan.rs",
      "lines": "164-169",
      "contract": {
        "precondition": "Input entry with invalid meal_type",
        "postcondition": "Entry rejected, error added to errors array, entry not synced",
        "invariant": "success field must be false if any meal_type errors"
      },
      "ears": {
        "normal": {
          "input": "meal_type: breakfast",
          "expected": "Synced with Breakfast",
          "status": "PASS"
        },
        "alternative": {
          "input": "meal_type: lunch",
          "expected": "Synced with Lunch",
          "status": "PASS"
        },
        "edge_invalid": {
          "input": "meal_type: invalid_type",
          "expected": "FAIL with error in errors array",
          "status": "FAIL-CURRENT"
        },
        "edge_empty": {
          "input": "meal_type: ''",
          "expected": "FAIL with error",
          "status": "FAIL-CURRENT"
        }
      },
      "schema": {
        "input_type": "string",
        "enum_values": ["breakfast", "lunch", "dinner", "snack"],
        "validation": "strict-case-insensitive",
        "output_on_invalid": "error pushed to errors array"
      },
      "test_cases": [
        {
          "name": "Valid breakfast",
          "input": "breakfast",
          "expected": "MealType::Breakfast"
        },
        {
          "name": "Invalid typo",
          "input": "breakfest",
          "expected": "error in errors array"
        },
        {
          "name": "Invalid custom",
          "input": "afternoon_snack",
          "expected": "error in errors array"
        }
      ],
      "acceptance_criteria": [
        "Invalid meal_type values rejected",
        "Error message: 'Invalid meal_type X: must be breakfast, lunch, dinner, or snack'",
        "Entry skipped (not synced)",
        "Error in errors array",
        "success = false if errors exist"
      ],
      "depends_on": []
    },
