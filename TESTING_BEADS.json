    {
      "id": "BEAD-001",
      "name": "Fix: meal_type Silent Default Validation",
      "priority": "P0-CRITICAL",
      "effort": "1 hour",
      "category": "BUG_FIX",
      "file": "src/bin/sync_meal_plan.rs",
      "lines": "164-169",
      "contract": {
        "current_behavior": "Invalid meal_type values silently default to Snack without error tracking",
        "desired_behavior": "Invalid meal_type values must be rejected with clear error message",
        "precondition": "Input entry with invalid meal_type",
        "postcondition": "Entry rejected, error added to errors array, entry not synced"
      },
      "ears": {
        "normal": {
          "input": "meal_type: 'breakfast'",
          "expected": "Synced with Breakfast meal type",
          "current_result": "PASS"
        },
        "alternative": {
          "input": "meal_type: 'snack'",
          "expected": "Synced with Snack meal type",
          "current_result": "PASS"
        },
        "edge": {
          "input": "meal_type: 'invalid_type'",
          "expected": "FAIL: error in errors array",
          "current_result": "FAIL (silently defaults to Snack)"
        },
        "error": {
          "input": "meal_type: ''",
          "expected": "FAIL with error",
          "current_result": "Defaults to Snack (BUG)"
        },
        "robustness": {
          "input": "meal_type: null",
          "expected": "FAIL with schema validation error",
          "current_result": "Unknown (need to test)"
        }
      },
      "schema": {
        "input": {
          "type": "string",
          "enum": ["breakfast", "lunch", "dinner", "snack"],
          "validation": "strict - case-insensitive but must be one of enum"
        },
        "output": {
          "on_valid": "MealType enum (Breakfast | Lunch | Dinner | Snack)",
          "on_invalid": "error: string pushed to errors array"
        },
        "edge_cases": [
          "Empty string",
          "null value",
          "Case variations (BREAKFAST, Breakfast, breakfast)",
          "Typos (breakfest)",
          "Extra whitespace (breakfast )",
          "Numbers (1 for breakfast)",
          "Unknown values (anything not in enum)"
        ]
      },
      "test_cases": [
        {
          "name": "Valid: breakfast lowercase",
          "input": "breakfast",
          "expected_output": "MealType::Breakfast",
          "expected_behavior": "Entry synced"
        },
        {
          "name": "Valid: LUNCH uppercase",
          "input": "LUNCH",
          "expected_output": "MealType::Lunch",
          "expected_behavior": "Entry synced (case-insensitive)"
        },
        {
          "name": "Invalid: typo breakfest",
          "input": "breakfest",
          "expected_output": "error in errors array",
          "expected_behavior": "Entry skipped, continue to next"
        },
        {
          "name": "Invalid: custom type",
          "input": "afternoon_snack",
          "expected_output": "error in errors array",
          "expected_behavior": "Entry skipped"
        },
        {
          "name": "Invalid: empty string",
          "input": "",
          "expected_output": "error in errors array",
          "expected_behavior": "Entry skipped"
        }
      ],
      "acceptance_criteria": [
        "Invalid meal_type values must be rejected",
        "Error message must be actionable: 'Invalid meal_type X: must be breakfast, lunch, dinner, or snack'",
        "Entry must be skipped (not synced)",
        "Error must be in errors array",
        "success field must be false if any errors exist",
        "All valid meal types still work"
      ],
      "implementation": {
        "pattern": "Match statement with explicit error on invalid",
        "code_change": "Replace _ => MealType::Snack with explicit error handling",
        "lines_to_modify": 6,
        "dependencies": "None (internal logic)"
      }
    },
    {
      "id": "BEAD-002",
      "name": "Add: --help Flag to Foundation Binaries",
      "priority": "P1-HIGH",
      "effort": "2 hours",
      "category": "FEATURE",
      "binaries": ["generate_encryption_key", "validate_encryption", "tandoor_test_connection"],
      "contract": {
        "precondition": "Binary invoked with --help, -h, or help argument",
        "postcondition": "Human-readable help text printed to stdout, exit 0"
      },
      "schema": {
        "input": "--help or -h or help (string argument)",
        "output": "Text (not JSON)",
        "format_requirements": [
          "USAGE section with examples",
          "INPUT SCHEMA section with field descriptions",
          "OUTPUT SCHEMA sections for success and error",
          "EXAMPLES section with 1-2 real examples",
          "EXIT CODES section",
          "NOTES section with important details"
        ]
      },
      "ears": {
        "normal": {
          "input": "./binary --help",
          "expected": "Help text printed"
        },
        "alternative": {
          "input": "./binary -h",
          "expected": "Identical help text"
        },
        "alternative2": {
          "input": "./binary help",
          "expected": "Identical help text"
        },
        "edge": {
          "input": "./binary '--help'",
          "expected": "Help text (quotes ignored)"
        },
        "error": {
          "input": "./binary --help ''",
          "expected": "Help text (extra args ignored if first arg is --help)"
        }
      },
      "test_cases": [
        {
          "name": "Help flag --help",
          "command": "./binary --help",
          "expected": "Output contains USAGE, INPUT SCHEMA, OUTPUT SCHEMA",
          "should_not_contain": "success: false (JSON error)"
        },
        {
          "name": "Help flag -h",
          "command": "./binary -h",
          "expected": "Same as --help",
          "should_not_contain": "JSON"
        },
        {
          "name": "Help flag help",
          "command": "./binary help",
          "expected": "Same as --help",
          "should_not_contain": "JSON"
        },
        {
          "name": "No args still expects JSON",
          "command": "echo '{}' | ./binary",
          "expected": "JSON output (not help)",
          "should_contain": "success"
        }
      ],
      "acceptance_criteria": [
        "--help, -h, help all work identically",
        "Help text is human-readable (not JSON)",
        "Help text includes USAGE section",
        "Help text includes INPUT SCHEMA with descriptions",
        "Help text includes OUTPUT SCHEMA examples",
        "Help text includes EXAMPLES with real-world use cases",
        "No JSON output when help flags used",
        "Exit code 0 (success)"
      ]
    },
    {
      "id": "BEAD-003",
      "name": "Add: --schema Introspection Flag",
      "priority": "P1-HIGH",
      "effort": "3 hours",
      "category": "FEATURE",
      "binaries": ["all foundation binaries"],
      "contract": {
        "precondition": "Binary invoked with --schema argument",
        "postcondition": "JSON schema describing input/output contracts printed to stdout, exit 0"
      },
      "schema": {
        "input": "--schema (string flag)",
        "output": {
          "type": "JSON object",
          "structure": {
            "binary_name": "string",
            "description": "string",
            "version": "string",
            "input": "JSON Schema (full type definition)",
            "output_success": "JSON Schema",
            "output_error": "JSON Schema",
            "examples": "array of {description, input, expected_output}"
          }
        },
        "format": "JSON Schema Draft 7 compatible"
      },
      "ears": {
        "normal": {
          "input": "./binary --schema",
          "expected": "Valid JSON with schema"
        },
        "edge": {
          "input": "./binary --schema | jq .",
          "expected": "Pipes to jq successfully"
        },
        "error": {
          "input": "./binary --schema '{}' (extra args after --schema)",
          "expected": "Ignores extra args, outputs schema"
        }
      },
      "test_cases": [
        {
          "name": "Schema output is valid JSON",
          "command": "./binary --schema | jq empty",
          "expected": "Exit 0 (valid JSON)"
        },
        {
          "name": "Schema has binary_name",
          "command": "./binary --schema | jq '.binary_name'",
          "expected": "Binary name as string"
        },
        {
          "name": "Schema has input schema",
          "command": "./binary --schema | jq '.input'",
          "expected": "JSON Schema object"
        },
        {
          "name": "Schema has examples",
          "command": "./binary --schema | jq '.examples | length'",
          "expected": "At least 1"
        },
        {
          "name": "Example input matches schema",
          "command": "./binary --schema | jq '.examples[0].input' | ./binary",
          "expected": "Should execute without validation error"
        }
      ],
      "acceptance_criteria": [
        "Valid JSON Schema Draft 7 output",
        "Schema describes all required input fields",
        "Schema describes all output success fields",
        "Schema describes all output error fields",
        "At least 2 example inputs provided",
        "Examples are valid according to schema",
        "AI can use schema to validate inputs before execution",
        "No breaking changes to normal operation"
      ]
    },
    {
      "id": "BEAD-004",
      "name": "Add: Input Validation for Numeric Bounds",
      "priority": "P2-MEDIUM",
      "effort": "2 hours",
      "category": "FEATURE",
      "binary": "sync_meal_plan",
      "contract": {
        "precondition": "MealPlanEntry with numeric fields (calories, protein, carbs, fat, servings, bmr)",
        "postcondition": "Values must be validated for reasonable bounds before processing"
      },
      "schema": {
        "fields": {
          "calories": {
            "type": "number",
            "constraints": "0 <= value <= 100000",
            "rejection": "value < 0 or value > 100000"
          },
          "protein": {
            "type": "number",
            "constraints": "0 <= value <= 10000",
            "rejection": "value < 0 or value > 10000"
          },
          "carbohydrate": {
            "type": "number",
            "constraints": "0 <= value <= 10000",
            "rejection": "value < 0 or value > 10000"
          },
          "fat": {
            "type": "number",
            "constraints": "0 <= value <= 10000",
            "rejection": "value < 0 or value > 10000"
          },
          "servings": {
            "type": "number",
            "constraints": "0 < value <= 1000",
            "rejection": "value <= 0 or value > 1000",
            "note": "Servings must be positive"
          },
          "bmr": {
            "type": "number",
            "constraints": "500 <= value <= 5000",
            "rejection": "value < 500 or value > 5000"
          }
        }
      },
      "ears": {
        "normal": {
          "calories": 300,
          "expected": "Accepted"
        },
        "edge_zero": {
          "calories": 0,
          "expected": "Accepted (valid edge case)"
        },
        "edge_max": {
          "calories": 100000,
          "expected": "Accepted (at boundary)"
        },
        "edge_large": {
          "calories": 999999,
          "expected": "Rejected: exceeds maximum"
        },
        "error_negative": {
          "calories": -100,
          "expected": "Rejected: must be >= 0"
        },
        "error_servings_zero": {
          "servings": 0,
          "expected": "Rejected: must be > 0"
        }
      },
      "test_cases": [
        {
          "name": "Negative calories",
          "input": "calories: -100",
          "expected": "error: Invalid calories -100: must be >= 0"
        },
        {
          "name": "Very large calories",
          "input": "calories: 999999",
          "expected": "error: Invalid calories 999999: must be <= 100000"
        },
        {
          "name": "Zero servings",
          "input": "servings: 0",
          "expected": "error: Invalid servings 0: must be > 0"
        },
        {
          "name": "Negative servings",
          "input": "servings: -1.5",
          "expected": "error: Invalid servings -1.5: must be > 0"
        },
        {
          "name": "Valid edge: zero calories",
          "input": "calories: 0",
          "expected": "Accepted (valid for water, spices, etc)"
        },
        {
          "name": "Valid edge: max value",
          "input": "calories: 100000",
          "expected": "Accepted (at boundary)"
        }
      ],
      "acceptance_criteria": [
        "Negative values for calories/macros rejected",
        "Zero servings rejected",
        "Out-of-range values rejected with clear error messages",
        "Errors added to errors array",
        "Entry skipped (not synced)",
        "success field is false if validation errors occur",
        "Zero calories allowed (edge case)",
        "Boundary values (max) allowed"
      ]
    },
    {
      "id": "BEAD-005",
      "name": "Add: Date Format Strict Validation",
      "priority": "P2-MEDIUM",
      "effort": "1.5 hours",
      "category": "FEATURE",
      "binaries": ["sync_meal_plan", "analyze_nutrition", "track_exercise_balance"],
      "contract": {
        "precondition": "Date field in YYYY-MM-DD format",
        "postcondition": "Date must match exact format, invalid dates rejected immediately"
      },
      "schema": {
        "format": "YYYY-MM-DD",
        "constraints": [
          "Exactly 10 characters",
          "Year: 1900-2099 (4 digits)",
          "Month: 01-12",
          "Day: 01-31 (depending on month)",
          "Case-sensitive"
        ],
        "edge_cases": [
          "2025-02-29 (invalid - not leap year)",
          "2024-02-29 (valid - leap year)",
          "2025-13-01 (invalid month)",
          "2025-01-32 (invalid day)",
          "2025-1-1 (invalid - no padding)",
          "2025/01/01 (invalid - wrong separator)",
          "01-01-2025 (invalid - wrong order)"
        ]
      },
      "ears": {
        "normal": {
          "input": "2025-01-09",
          "expected": "Accepted"
        },
        "valid_edge": {
          "input": "2024-02-29",
          "expected": "Accepted (leap year)"
        },
        "invalid_format": {
          "input": "2025-1-9",
          "expected": "Rejected: must be YYYY-MM-DD"
        },
        "invalid_month": {
          "input": "2025-13-01",
          "expected": "Rejected: invalid month"
        },
        "invalid_day_month": {
          "input": "2025-02-29",
          "expected": "Rejected: not leap year"
        }
      },
      "test_cases": [
        {
          "name": "Valid date",
          "input": "2025-01-15",
          "expected": "Accepted"
        },
        {
          "name": "Valid leap year",
          "input": "2024-02-29",
          "expected": "Accepted"
        },
        {
          "name": "Invalid: missing leading zeros",
          "input": "2025-1-9",
          "expected": "Rejected: must be YYYY-MM-DD format"
        },
        {
          "name": "Invalid: wrong separator",
          "input": "2025/01/09",
          "expected": "Rejected: must use hyphens"
        },
        {
          "name": "Invalid: month out of range",
          "input": "2025-13-01",
          "expected": "Rejected: month must be 01-12"
        },
        {
          "name": "Invalid: day out of range for month",
          "input": "2025-04-31",
          "expected": "Rejected: day out of range for April"
        },
        {
          "name": "Invalid: February 29 in non-leap",
          "input": "2025-02-29",
          "expected": "Rejected: not a leap year"
        }
      ],
      "acceptance_criteria": [
        "Strict format validation: YYYY-MM-DD",
        "Month must be 01-12",
        "Day must be valid for month (including leap year logic)",
        "Year must be reasonable (1900-2099)",
        "Error message includes expected format",
        "Date is parsed and validated before use",
        "Invalid dates skip entry (for sync_meal_plan)"
      ]
    },
